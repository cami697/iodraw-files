y distal","textPreferences":{"alignment":0,"color":-16777216,"effect":0,"paddingH":8,"paddingV":3,"size":14}},{"children":[],"id":16,"linePreferences":{"arrow":0,"color":-12303292,"curve":1,"effect":0,"width":4},"nodePreferences":{"color":-1,"outlineColor":-7829368,"outlineWidth":4,"shape":0},"parent":15,"pos":[2101,4517],"side":0,"text":"Opciones:\n- Hombro: Cabestrillo + venda cruzada\n- Codo: Férula antebraquial 90°\n- Cadera: Tabla de estabilización, no rotación\n- Rodilla: Férula rígida en extensión o ligera flexión","textPreferences":{"alignment":0,"color":-16777216,"effect":0,"paddingH":8,"paddingV":3,"size":14}},{"children":[30],"id":17,"linePreferences":{"arrow":0,"color":-12303292,"curve":1,"effect":0,"width":4},"nodePreferences":{"color":-1,"outlineColor":-7829368,"outlineWidth":4,"shape":0},"parent":28,"pos":[1642,5303],"side":0,"text":"SI","textPreferences":{"alignment":0,"color":-16777216,"effect":0,"paddingH":8,"paddingV":3,"size":14}},{"children":[21],"id":18,"linePreferences":{"arrow":0,"color":-12303292,"curve":1,"effect":0,"width":4},"nodePreferences":{"color":-1,"outlineColor":-7829368,"outlineWidth":4,"shape":0},"parent":15,"pos":[2110,4849],"side":0,"text":"- Indicación: Realizar \u003c6h \n(mejor pronóstico, menor riesgo de \nnecrosis avascular) bajo analgesia/sedación","textPreferences":{"alignment":0,"color":-16777216,"effect":0,"paddingH":8,"paddingV":3,"size":14}},{"children":[],"id":19,"linePreferences":{"arrow":0,"color":-12303292,"curve":1,"effect":0,"width":4},"nodePreferences":{"color":-1,"outlineColor":-7829368,"outlineWidth":4,"shape":0},"parent":15,"pos":[3993,4754],"side":0,"text":"​- Contraindicación relativa: Fractura \ndesplazada, bloqueo mecánico, atrapamiento \nnervioso/óseo → NO forzar → CIRUGÍA","textPreferences":{"alignment":0,"color":-16777216,"effect":0,"paddingH":8,"paddingV":3,"size":14}},{"children":[22],"id":20,"linePreferences":{"arrow":0,"color":-12303292,"curve":1,"effect":0,"width":4},"nodePreferences":{"color":-1,"outlineColor":-7829368,"outlineWidth":4,"shape":0},"parent":15,"pos":[3057,4847],"side":0,"text":"- Posreducción: Reevaluación neurovascular + Rx confirmatoria; \ncomprobar estabilidad articular","textPreferences":{"alignment":0,"color":-16777216,"effect":0,"paddingH":8,"paddingV":3,"size":14}},{"children":[23,24,25,28],"id":21,"linePreferences":{"arrow":0,"color":-12303292,"curve":1,"effect":0,"width":4},"nodePreferences":{"color":-1,"outlineColor":-7829368,"outlineWidth":4,"shape":0},"parent":18,"pos":[2975,5126],"side":0,"text":"Iniciar antibioticoterapia \nen caso de ser necesario","textPreferences":{"alignment":0,"color":-16777216,"effect":0,"paddingH":8,"paddingV":3,"size":14}},{"children":[],"id":22,"linePreferences":{"arrow":0,"color":-12303292,"curve":1,"effect":0,"width":4},"nodePreferences":{"color":-1,"outlineColor":-7829368,"outlineWidth":4,"shape":0},"parent":20,"pos":[2928,5124],"side":0,"text":"","textPreferences":{"alignment":0,"color":-16777216,"effect":0,"paddingH":8,"paddingV":3,"size":14}},{"children":[27],"id":23,"linePreferences":{"arrow":0,"color":-12303292,"curve":1,"effect":0,"width":4},"nodePreferences":{"color":-1,"outlineColor":-7829368,"outlineWidth":4,"shape":0},"parent":21,"pos":[3804,5021],"side":0,"text":"1ª Línea (Profilaxis/infección leve): \n- Cefazolina 1gr EV c/8h \n- Amoxicilina + Ác. Clavulánico 875/125mg VO c/12h","textPreferences":{"alignment":0,"color":-16777216,"effect":0,"paddingH":8,"paddingV":3,"size":14}},{"children":[],"id":24,"linePreferences":{"arrow":0,"color":-12303292,"curve":1,"effect":0,"width":4},"nodePreferences":{"color":-1,"outlineColor":-7829368,"outlineWidth":4,"shape":0},"parent":21,"pos":[3845,5187],"side":0,"text":"2ª Línea (Contaminación moderada/fractura asociada): \n- Ampicilina-Sulbactam 1.5gr EV c/6h \n- Ceftriaxona 2gr EV c/24h + Metronidazol 500mg EV c/8h","textPreferences":{"alignment":0,"color":-16777216,"effect":0,"paddingH":8,"paddingV":3,"size":14}},{"children":[26],"id":25,"linePrefere